{
    "name": "anime-girlfriend",
    "displayName": "Anime Girlfriend - BOJ Companion",
    "description": "Your supportive anime companion for competitive programming with BOJ integration",
    "version": "0.1.0",
    "publisher": "anime-girlfriend",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "anime-girlfriend.showChat",
                "title": "Show Chat",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.enterApiKey",
                "title": "Enter OpenAI API Key",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.resetProfile",
                "title": "Reset Profile (Re-Onboard)",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.debugProfile",
                "title": "Debug: Show Stored Profile",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.debugStorage",
                "title": "Debug: Show All Storage (Cached Problems, Hint Levels)",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.ingestSolutions",
                "title": "RAG: Ingest BOJ Solutions",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.ingestProblemTags",
                "title": "RAG: Fetch BOJ Problem Tags from solved.ac",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.clearMemory",
                "title": "RAG: Clear Memory",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.ragStats",
                "title": "RAG: Show Statistics",
                "category": "Anime Girlfriend"
            },
            {
                "command": "anime-girlfriend.testRAG",
                "title": "RAG: Test Query (Debug)",
                "category": "Anime Girlfriend"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "anime-girlfriend",
                    "title": "Anime Girlfriend",
                    "icon": "assets/icon.svg"
                }
            ]
        },
        "views": {
            "anime-girlfriend": [
                {
                    "id": "anime-girlfriend.chat",
                    "name": "Chat",
                    "type": "webview"
                }
            ]
        },
        "configuration": {
            "title": "Anime Girlfriend",
            "properties": {
                "anime-girlfriend.serverPort": {
                    "type": "number",
                    "default": 3000,
                    "description": "Port for the local server that receives BOJ signals"
                },
                "anime-girlfriend.openaiModel": {
                    "type": "string",
                    "default": "gpt-4o-mini",
                    "enum": [
                        "gpt-4o-mini",
                        "gpt-4o",
                        "gpt-3.5-turbo"
                    ],
                    "description": "OpenAI model for chat"
                },
                "anime-girlfriend.database.host": {
                    "type": "string",
                    "default": "localhost",
                    "description": "PostgreSQL database host for RAG system"
                },
                "anime-girlfriend.database.port": {
                    "type": "number",
                    "default": 5432,
                    "description": "PostgreSQL database port"
                },
                "anime-girlfriend.database.name": {
                    "type": "string",
                    "default": "anime_girlfriend_rag",
                    "description": "PostgreSQL database name"
                },
                "anime-girlfriend.database.user": {
                    "type": "string",
                    "default": "postgres",
                    "description": "PostgreSQL database user"
                },
                "anime-girlfriend.database.password": {
                    "type": "string",
                    "default": "postgres",
                    "description": "PostgreSQL database password"
                },
                "anime-girlfriend.rag.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable RAG (Retrieval-Augmented Generation) for enhanced memory"
                },
                "anime-girlfriend.rag.maxResults": {
                    "type": "number",
                    "default": 5,
                    "description": "Maximum number of relevant documents to retrieve for context"
                },
                "anime-girlfriend.rag.autoIngestOnStartup": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically ingest BOJ solutions on extension startup"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "node esbuild.js",
        "watch": "node esbuild.js --watch",
        "package": "vsce package",
        "init-boj-tags": "node scripts/fetch-boj-tags.js"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/node-fetch": "^2.6.13",
        "@types/pg": "^8.10.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/vscode": "^1.74.0",
        "esbuild": "^0.19.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@xenova/transformers": "^2.10.0",
        "glob": "^10.3.0",
        "node-fetch": "^2.7.0",
        "pg": "^8.11.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    }
}
